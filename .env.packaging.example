# Optional local signing configuration. Never commit real credentials.
MACOS_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# Prefer a profile created with `xcrun notarytool store-credentials`.
APPLE_NOTARY_KEYCHAIN_PROFILE="aiui-workbench"
# Alternatively set APPLE_API_KEY to a local AuthKey_*.p8 path,
# APPLE_API_KEY_ID and APPLE_API_ISSUER in the process environment.
