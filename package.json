{
  "name": "aiui-workbench",
  "productName": "AIUI 工坊",
  "version": "0.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Local AIUI desktop workbench, official runtime simulator and MCP tools",
  "bin": {
    "aiui-workbench": "web/cli.mjs"
  },
  "files": [
    "core/",
    "shared/",
    "web/",
    "mcp/",
    "electron/",
    "dist/",
    "assets/",
    "vendor/official/",
    "vendor/adb/",
    "vendor/scrcpy/",
    "docs/web-and-updates.md",
    "docs/ai-tool-workflows.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.json"
  ],
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "service": "node core/daemon.mjs",
    "web": "npm run build && node web/cli.mjs",
    "prepack": "npm run build",
    "release:manifest": "node scripts/release-manifest.mjs",
    "qa:web-updates": "npm run build && node scripts/qa-web-updates.mjs",
    "mcp": "node mcp/server.mjs",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=60000 tests/*.test.mjs",
    "qa": "npm run qa:screenshots",
    "package": "npm run build && node scripts/package.mjs",
    "prepare:adb": "node scripts/prepare-adb.mjs --all",
    "prepare:scrcpy": "node scripts/prepare-scrcpy.mjs --all",
    "qa:glasses": "npm run build && node scripts/qa-glasses-tools.mjs",
    "qa:logs": "node scripts/qa-logs.mjs",
    "qa:simulator": "node scripts/qa-simulator.mjs",
    "qa:recording": "npm run build && node scripts/qa-recording.mjs",
    "qa:mcp-workflows": "npm run build && node scripts/qa-mcp-workflows.mjs",
    "qa:mcp-stability": "node scripts/qa-mcp-stability.mjs",
    "qa:camera": "node scripts/qa-camera.mjs",
    "qa:documents": "npm run build && node scripts/qa-documents.mjs",
    "qa:sdk": "node scripts/qa-sdk.mjs",
    "package:win": "npm run build && node scripts/package.mjs --platform win32 --arch x64",
    "qa:portable": "node scripts/qa-portable.mjs",
    "qa:i18n": "npm run build && node scripts/qa-i18n.mjs",
    "prepare:tools": "npm run prepare:adb && npm run prepare:scrcpy",
    "check:public": "node scripts/check-public.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "package:mac:release": "npm run build && node scripts/package.mjs --platform darwin --arch arm64 --sign --out output/release",
    "notarize:mac": "node scripts/notarize-mac.mjs",
    "package:dmg": "node scripts/create-dmg.mjs",
    "qa:screenshots": "npm run build && node scripts/capture-docs.mjs",
    "qa:project-removal": "npm run build && node scripts/qa-project-removal.mjs",
    "qa:github-upgrade": "node scripts/qa-github-upgrade.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@yodaos-pkg/aix-cli": "0.12.0",
    "@yodaos-pkg/create-aiui-agent": "2.1.3",
    "@yodaos-pkg/ink": "0.19.1",
    "chokidar": "6.0.0",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "ignore": "7.0.14",
    "lucide-react": "1.71.0",
    "npm": "11.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "semver": "7.8.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "playwright": "1.65.0",
    "vite": "8.3.7",
    "@electron/osx-sign": "2.7.2"
  },
  "license": "MIT",
  "author": "AIUI Workbench contributors",
  "homepage": "https://github.com/syjstc/aiui-workbench",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syjstc/aiui-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/syjstc/aiui-workbench/issues"
  }
}
